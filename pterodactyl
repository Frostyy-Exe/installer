echo -e "  ${WHITE}1)${BLUE} KVM"
echo -e "  ${WHITE}2)${BLUE} NON-KVM"
echo -e "  ${WHITE}3)${BLUE} BACK"
echo -e "${BLUE}════════════════════════════════════════════════════════════${RESET}"
echo ""

read -p "Select: " vps

case "$vps" in
1)
echo -e "${YELLOW}KVM installer not added yet.${RESET}"
read -p "Press Enter to continue..."
;;

2)
bash <(curl -fsSL https://raw.githubusercontent.com/freediamodns/FreeVps/refs/heads/main/ifuusethiscodewithoutcredituragay)
;;

3)
continue
;;

*)
echo -e "${RED}Invalid option${RESET}"
sleep 2
;;
esac
;;

2)
clear

echo -e "${GREEN}"
cat <<'PANEL'
  ___  _   _  _ ___ _      ___ _  _ ___ _____ _   _    _    ___ ___
 | _ \/_\ | \| | __| |    |_ _| \| / __|_   _/_\ | |  | |  | __| _ \
 |  _/ _ \| .` | _|| |__   | || .` \__ \ | |/ _ \| |__| |__| _||   /
 |_|/_/ \_\_|\_|___|____| |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\
PANEL
echo -e "${RESET}"

echo -e "${GREEN}════════════════════════════════════════════════════════════${RESET}"
echo -e "  ${WHITE}1)${GREEN} PTERODACTYL"
echo -e "  ${WHITE}2)${GREEN} JTG PANEL"
echo -e "  ${WHITE}0)${GREEN} BACK"
