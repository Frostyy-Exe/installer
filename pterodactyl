cat > pterodactyl <<'EOF'
#!/bin/bash

CYAN='\033[1;36m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

box() {
    local color="$1"
    local title="$2"

    shift 2

    mapfile -t lines < <(printf '%s\n' "$@")

    local width=0
    local line len

    for line in "${lines[@]}"; do
        len=${#line}
        (( len > width )) && width=$len
    done

    (( width < ${#title} + 4 )) && width=$((${#title} + 4))

    echo -e "${color}╔$(printf '═%.0s' $(seq 1 $((width + 2))))╗${RESET}"

    for line in "${lines[@]}"; do
        printf -v spaces '%*s' $((width - ${#line})) ''
        echo -e "${color}║ ${line}${spaces} ║${RESET}"
    done

    echo -e "${color}╠$(printf '═%.0s' $(seq 1 $((width + 2))))╣${RESET}"

    printf -v title_spaces '%*s' $((width - ${#title})) ''
    echo -e "${color}║ ${title}${title_spaces} ║${RESET}"

    echo -e "${color}╚$(printf '═%.0s' $(seq 1 $((width + 2))))╝${RESET}"
}

while true; do
    clear

    box "$CYAN" "F R O S T Y Y   I N S T A L L E R" \
"  ___ ___  ___  ___ _______   ____   __  ___ _  _ ___ _____ _   _    _    ___ ___ " \
" | __| _ \/ _ \/ __|_   _\ \ / /\ \ / / |_ _| \| / __|_   _/_\ | |  | |  | __| _ \" \
" | _||   / (_) \__ \ | |  \ V /  \ V /   | || .\` \__ \ | |/ _ \| |__| |__| _||   /" \
" |_| |_|_\\___/|___/ |_|   |_|    |_|   |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\ "

    echo ""
    echo "1) VPS"
    echo "2) PANEL"
    echo "3) TOOLBOX"
    echo "4) EXIT"
    echo ""

    read -p "Select: " main

    case "$main" in

        1)
            clear

            box "$BLUE" "VPS INSTALLER" \
" __   _____  ___   ___ _  _ ___ _____ _   _    _    ___ ___" \
" \ \ / / _ \/ __| |_ _| \| / __|_   _/_\ | |  | |  | __| _ \" \
"  \ V /|  _/\__ \  | || .\` \__ \ | |/ _ \| |__| |__| _||   /" \
"   \_/ |_|  |___/ |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\ "

            echo ""
            echo "1) KVM"
            echo "2) NON-KVM"
            echo "3) BACK"
            echo ""

            read -p "Select: " vps

            case "$vps" in
                1)
                    echo -e "${YELLOW}KVM installer not added yet.${RESET}"
                    read -p "Press Enter to continue..."
                    ;;
                2)
                    bash <(curl -fsSL https://raw.githubusercontent.com/freediamodns/FreeVps/refs/heads/main/ifuusethiscodewithoutcredituragay)
                    ;;
                3)
                    continue
                    ;;
                *)
                    echo -e "${RED}Invalid option${RESET}"
                    sleep 2
                    ;;
            esac
            ;;

        2)
            clear

            box "$GREEN" "PANEL INSTALLER" \
"  ___  _   _  _ ___ _      ___ _  _ ___ _____ _   _    _    ___ ___ " \
" | _ \/_\ | \| | __| |    |_ _| \| / __|_   _/_\ | |  | |  | __| _ \" \
" |  _/ _ \| .\` | _|| |__   | || .\` \__ \ | |/ _ \| |__| |__| _||   /" \
" |_|/_/ \_\_|\_|___|____| |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\ "

            echo ""
            echo "1) PTERODACTYL"
            echo "2) JTG PANEL"
            echo "0) BACK"
            echo ""

            read -p "Select: " panel

            case "$panel" in
                1)
                    echo -e "${YELLOW}Pterodactyl installer not added yet.${RESET}"
                    read -p "Press Enter to continue..."
                    ;;
                2)
                    bash <(curl -fsSL https://raw.githubusercontent.com/JishnuTheGamer/Jtg/refs/heads/main/install.sh)
                    ;;
                0)
                    continue
                    ;;
                *)
                    echo -e "${RED}Invalid option${RESET}"
                    sleep 2
                    ;;
            esac
            ;;

        3)
            clear

            box "$YELLOW" "TOOLBOX" \
"  _____ ___   ___  _    ___  _____  __" \
" |_   _/ _ \ / _ \| |  | _ )/ _ \ \/ /" \
"   | || (_) | (_) | |__| _ \ (_) >  < " \
"   |_| \___/ \___/|____|___/\___/_/\_\ "

            echo ""
            echo "Toolbox coming soon."
            echo ""
            read -p "Press Enter to continue..."
            ;;

        4)
            clear
            exit 0
            ;;

        *)
            echo -e "${RED}Invalid option${RESET}"
            sleep 2
            ;;
    esac
done
EOF

bash -n pterodactyl && bash pterodactyl
