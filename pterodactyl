 |_| |_|_\\___/|___/ |_|   |_|    |_|   |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\
BANNER
echo -e "${RESET}"

echo -e "${CYAN}════════════════════════════════════════════════════════════${RESET}"
echo -e "  ${WHITE}1)${CYAN} VPS"
echo -e "  ${WHITE}2)${CYAN} PANEL"
echo -e "  ${WHITE}3)${CYAN} TOOLBOX"
echo -e "  ${WHITE}4)${RED} EXIT"
echo -e "${CYAN}════════════════════════════════════════════════════════════${RESET}"
echo ""

read -p "Select: " main

case "$main" in

1)
clear

echo -e "${BLUE}"
cat <<'VPS'
