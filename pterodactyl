;;

2)
bash <(curl -fsSL https://raw.githubusercontent.com/JishnuTheGamer/Jtg/refs/heads/main/install.sh)
;;

0)
continue
;;

*)
echo -e "${RED}Invalid option${RESET}"
sleep 2
;;
esac
;;

3)
clear

echo -e "${YELLOW}"
cat <<'TOOLBOX'
  _____ ___   ___  _    ___  _____  __
 |_   _/ _ \ / _ \| |  | _ )/ _ \ \/ /
   | || (_) | (_) | |__| _ \ (_) >  <
   |_| \___/ \___/|____|___/\___/_/\_\
TOOLBOX
echo -e "${RESET}"

echo -e "${YELLOW}════════════════════════════════════════════════════════════${RESET}"
echo -e "                 ${WHITE}TOOLBOX${RESET}"
echo -e "${YELLOW}════════════════════════════════════════════════════════════${RESET}"
echo ""
echo -e "${YELLOW}                 Toolbox coming soon.${RESET}"
echo ""
read -p "Press Enter to continue..."
;;

4)
clear
echo -e "${RED}Thanks for using Frostyy Installer!${RESET}"
