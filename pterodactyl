#!/bin/bash

while true; do
    clear

    cat <<'BANNER'
  ___ ___  ___  ___ _______   ____   __  ___ _  _ ___ _____ _   _    _    ___ ___  
 | __| _ \/ __|/ _ \_   _\ \ / /\ \ / / |_ _| \| / __|_   _/_\ | |  | |  | __| _ \ 
 | _||   /\__ \ (_) || |  \ V /  \ V /   | || .` \__ \ | |/ _ \| |__| |__| _||   / 
 |_| |_|_\|___/\___/ |_|   |_|    |_|   |___|_|\_|___/ |_/_/ \_\____|____|___|_|_\ 
BANNER

      echo ""
      echo "1) VPS"
      echo "2) PANEL"
      echo "3) TOOLBOX"
      echo "4) EXIT"
      echo ""

    read -p "Select: " main

    case "$main" in
        1)
            clear
            echo "========== VPS INSTALLER =========="
            echo ""
            echo "1) KVM"
            echo "2) NON-KVM"
            echo "3) BACK"
            echo ""

            read -p "Select: " vps

            case "$vps" in
                1)
                    echo "KVM installer not added yet."
                    read -p "Press Enter to continue..."
                    ;;
                2)
                    bash <(curl -fsSL https://raw.githubusercontent.com/freediamodns/FreeVps/refs/heads/main/ifuusethiscodewithoutcredituragay)
                    ;;
                3)
                    continue
                    ;;
                *)
                    echo "Invalid option"
                    sleep 2
                    ;;
            esac
            ;;

        2)
            clear
            echo "========= PANEL INSTALLER ========="
            echo ""
            echo "1) PTERODACTYL"
            echo "2) JTG PANEL"
            echo "0) BACK"
            echo ""

            read -p "Select: " panel

            case "$panel" in
                1)
                    echo "Pterodactyl installer not added yet."
                    read -p "Press Enter to continue..."
                    ;;
                2)
                    bash <(curl -fsSL https://raw.githubusercontent.com/JishnuTheGamer/Jtg/refs/heads/main/install.sh)
                    ;;
                0)
                    continue
                    ;;
                *)
                    echo "Invalid option"
                    sleep 2
                    ;;
            esac
            ;;

        3)
            clear
            echo "=========== TOOLBOX ==============="
            echo ""
            echo "Toolbox coming soon."
            echo ""
            read -p "Press Enter to continue..."
            ;;

        4)
            clear
            exit 0
            ;;

        *)
            echo "Invalid option"
            sleep 2
            ;;
    esac
done
